# Optional provider credentials.
# This file is a template. Copy it to a private environment file and fill in your keys.
# Never commit a file containing real credentials.
#
# Loading:
# - GUARDIAN_ENV_FILE can point to this file's absolute path.
# - Without GUARDIAN_ENV_FILE, GuardStack AI looks for .env in its package installation directory.
# - It does not load .env from the analysed workspace automatically.

GEMINI_API_KEY=
GROQ_API_KEY=

# Optional model overrides.
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=openai/gpt-oss-120b

# External LLM use is opt-in.
# Accepted enabled values: on, true, 1, yes.
# Also requires at least one provider key and "llm": true in .guardianrc.
# Run "guardian optimize --dry-run" to inspect the outbound payload first.
GUARDIAN_LLM=off

# debug | info | warn | error
GUARDIAN_LOG=warn
