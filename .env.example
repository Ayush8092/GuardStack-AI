# Copy to .env and fill in. Never commit .env.
# Keys are optional: without them CodeGuardian is fully local and skips the LLM step.

GEMINI_API_KEY=
GROQ_API_KEY=

# Model ids change often. Update them here instead of touching code.
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=openai/gpt-oss-120b

# off (default) = fully local, nothing leaves this machine.
# on = External LLM mode: optional prompt clarification is sent to Gemini/Groq after secret masking
#      (request, up to 8 symbol signatures with paths, folder summary; never file contents).
#      Also needs a key above and "llm": true in .guardianrc.
#      Run "guardian optimize --dry-run" to see the exact payload first.
GUARDIAN_LLM=off

# debug | info | warn | error  (logs go to stderr, secrets are masked)
GUARDIAN_LOG=warn
